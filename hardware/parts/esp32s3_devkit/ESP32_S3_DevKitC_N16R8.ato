"""
ESP32-S3 DevKitC-1 N16R8 — Development board
  - Espressif ESP32-S3R8 chip (QFN56)
  - 16 MB quad SPI flash (128 Mbit)
  - 8 MB octal PSRAM (64 Mbit, 80 MHz)
  - 2× 19-pin 2.54 mm female headers
  - On-board 3.3 V LDO (AMS1117-3.3)
  - USB-Serial via CP2102 (GPIO43/GPIO44)

This is an atomic part definition — it maps the physical
DevKit header pins to named signals for easy connection.
"""

#pragma experiment("TRAITS")
import has_designator_prefix
import has_part_picked

component ESP32_S3_DevKitC_N16R8:
    trait has_designator_prefix<prefix="U">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C2838502", manufacturer="Espressif", partno="ESP32-S3-DevKitC-1-N16R8">

    # ── Left header (J1) ──
    signal P3V3 ~ pin 1
    signal EN    ~ pin 2          # Reset (active low)
    signal IO0   ~ pin 3          # GPIO0 / Boot
    signal IO1   ~ pin 4          # GPIO1 / Topway UART TX
    signal IO2   ~ pin 5          # GPIO2 / Fault LED
    signal IO3   ~ pin 6          # GPIO3 / Topway UART RX
    signal IO4   ~ pin 7          # GPIO4 / DS18B20 T_in 1-Wire
    signal IO5   ~ pin 8          # GPIO5 / Wi-Fi LED
    signal IO6   ~ pin 9          # GPIO6 / SCT-013 ADC
    signal IO7   ~ pin 10         # GPIO7 / available
    signal IO8   ~ pin 11         # GPIO8 / available
    signal IO9   ~ pin 12         # GPIO9 / available
    signal IO10  ~ pin 13         # GPIO10 / available
    signal IO11  ~ pin 14         # GPIO11 / Touch CS
    signal IO12  ~ pin 15         # GPIO12 / Touch SCLK
    signal IO13  ~ pin 16         # GPIO13 / Touch MOSI
    signal IO14  ~ pin 17         # GPIO14 / Touch IRQ
    signal IO15  ~ pin 18         # GPIO15 / DS18B20 T_out 1-Wire
    signal P5V   ~ pin 19         # 5V input (DevKit LDO)

    # ── Right header (J2) ──
    signal GND ~ pin 20
    GND ~ pin 21
    signal IO16 ~ pin 22          # GPIO16 / Touch MISO
    signal IO17 ~ pin 23          # GPIO17 / available
    signal IO18 ~ pin 24          # GPIO18 / available
    signal IO19 ~ pin 25          # GPIO19 / available (USB D-)
    signal IO20 ~ pin 26          # GPIO20 / available (USB D+)
    signal IO21 ~ pin 27          # GPIO21 / available
    signal IO35 ~ pin 28          # GPIO35 / available
    signal IO36 ~ pin 29          # GPIO36 / available
    signal IO37 ~ pin 30          # GPIO37 / available
    signal IO38 ~ pin 31          # GPIO38 / available
    signal IO39 ~ pin 32          # GPIO39 / available
    signal IO40 ~ pin 33          # GPIO40 / available
    signal IO41 ~ pin 34          # GPIO41 / available
    signal IO42 ~ pin 35          # GPIO42 / available
    signal IO43 ~ pin 36          # GPIO43 / Console RX (USB-Serial)
    signal IO44 ~ pin 37          # GPIO44 / Console TX (USB-Serial)
    signal IO45 ~ pin 38          # GPIO45 / strapping
