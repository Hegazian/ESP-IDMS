# ESP32-S3 N16R8: 16 MB quad flash, 8 MB octal PSRAM (typical ESP32-S3-WROOM-1 / DevKitC-1 N16R8)
# Applied automatically when target is esp32s3 (in addition to sdkconfig.defaults).

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# OTA partition table (16 MB flash)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota_16m.csv"

# More app space via OTA layout
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
# CONFIG_PARTITION_TABLE_TWO_OTA_LARGE is not set

# Reduce internal DRAM pressure when Wi-Fi is enabled
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Default LCD bus to SPI on ESP32-S3 (4-wire serial interface)
# Use I80=y only if your 3.5" TFT has an 8080 FPC connector
CONFIG_IDMS_LCD_BUS_SPI=y
