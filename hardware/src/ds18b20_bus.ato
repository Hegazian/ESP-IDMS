"""
DS18B20 1-Wire Temperature Sensor Bus

Components:
  R_pullup (4.7kΩ): 1-Wire pull-up to 3.3V
  R_series (100Ω): ESD current limiting
  D_esd (PESD5V0S1BA): ESD protection TVS diode
  J_sensor (JST-XH-3P): Probe connector (VCC, DQ, GND)

Used twice: T_in bus (GPIO4) and T_out bus (GPIO15).
Each bus is independent (separate 1-Wire bus, separate pull-up).
"""

#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
import Electrical
import ElectricPower
import Resistor
from "parts/pesd5v0s1ba/PESD5V0S1BA.ato" import PESD5V0S1BA
from "parts/jst_xh/JST_XH.ato" import JST_XH_3P_RA

module DS18B20_Bus:
    power = new ElectricPower
    power.required = True

    r_pullup = new Resistor     # 4.7kΩ to 3.3V
    r_series = new Resistor     # 100Ω ESD current limiting
    d_esd = new PESD5V0S1BA     # TVS to GND
    j_sensor = new JST_XH_3P_RA # Probe connector

    signal mcu_pin     # Connected to ESP32 GPIO (GPIO4 or GPIO15)
    signal ow_bus      # 1-Wire data bus (after ESD protection)

    # Pull-up: 3.3V → 4.7kΩ → OW bus
    power.hv ~> r_pullup ~> ow_bus

    # ESD series resistor: MCU pin → 100Ω → OW bus
    mcu_pin ~> r_series ~> ow_bus

    # ESD TVS diode: OW bus → cathode, GND → anode
    ow_bus ~ d_esd.CATHODE
    power.lv ~ d_esd.ANODE

    # Sensor connector
    power.hv ~ j_sensor.1    # VCC
    ow_bus ~ j_sensor.2      # DQ (data)
    power.lv ~ j_sensor.3    # GND

    # Component parameters
    r_pullup.resistance = 4.7kohm +/- 1%
    r_pullup.package = "0805"
    r_series.resistance = 100ohm +/- 5%
    r_series.package = "0805"

    assert power.voltage within 3.0V to 3.6V
