"""
SCT-013 Current Transformer Bias Network

Components:
  R1 (10kΩ): Voltage divider upper leg (3.3V → bias midpoint)
  R2 (10kΩ): Voltage divider lower leg (bias midpoint → GND)
  C1 (10µF): DC stabilization capacitor at midpoint
  C2/C3 (1nF): Pi filter shunt capacitors
  R_filt (100Ω): Pi filter series resistor
  R_burden (33Ω, DNP): Burden resistor (only for SCT-013-000 100A variant)
  D3 (PESD5V0S1BA): ESD protection TVS diode

Outputs:
  signal adc_out: Filtered ADC signal (~1.65V DC bias + AC CT waveform)

The bias network creates a 1.65 V DC midpoint so the AC waveform
rides within the ADC's 0–3.3 V range.
"""

#pragma experiment("TRAITS")
#pragma experiment("BRIDGE_CONNECT")
import Electrical
import ElectricPower
import Resistor
import Capacitor
from "parts/pesd5v0s1ba/PESD5V0S1BA.ato" import PESD5V0S1BA

module SCT013_Bias_Network:
    # Voltage divider resistors
    r1 = new Resistor   # 10kΩ 1%, 3.3V → midpoint
    r2 = new Resistor   # 10kΩ 1%, midpoint → GND
    # DC stabilization cap
    c1 = new Capacitor  # 10µF 25V electrolytic
    # Pi filter
    r_filt = new Resistor   # 100Ω series
    c2 = new Capacitor      # 1nF shunt to GND
    c3 = new Capacitor      # 1nF shunt to GND
    # Burden (DNP for SCT-013-030)
    r_burden = new Resistor  # 33Ω, only for 100A variant
    # ESD protection
    d_esd = new PESD5V0S1BA

    power = new ElectricPower
    power.required = True

    signal bias_midpoint   # Raw bias midpoint (before Pi filter)
    signal adc_output       # Filtered ADC signal (after Pi filter)

    # Voltage divider: 3.3V → R1 → midpoint → R2 → GND
    power.hv ~> r1 ~> bias_midpoint
    bias_midpoint ~> r2 ~> power.lv

    # DC stabilization cap from midpoint to GND
    bias_midpoint ~> c1 ~> power.lv

    # Pi filter: midpoint → R_filt → output → C2/C3 → GND
    bias_midpoint ~> r_filt ~> adc_output
    adc_output ~> c2 ~> power.lv
    adc_output ~> c3 ~> power.lv

    # ESD protection: TVS from bias midpoint to GND
    bias_midpoint ~ d_esd.CATHODE
    power.lv ~ d_esd.ANODE

    # Burden resistor: bias midpoint → GND (DNP for SCT-013-030)
    bias_midpoint ~> r_burden ~> power.lv

    # Component parameters
    r1.resistance = 10kohm +/- 1%
    r1.package = "0805"
    r2.resistance = 10kohm +/- 1%
    r2.package = "0805"
    c1.capacitance = 10uF +/- 20%
    c1.max_voltage = 16V to 50V
    r_filt.resistance = 100ohm +/- 5%
    r_filt.package = "0805"
    c2.capacitance = 1nF +/- 20%
    c2.package = "0805"
    c3.capacitance = 1nF +/- 20%
    c3.package = "0805"
    r_burden.resistance = 33ohm +/- 1%
    r_burden.package = "0805"

    assert power.voltage within 3.0V to 3.6V
