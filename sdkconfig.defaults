CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
# Timer task stack increased: Wi-Fi reconnect timer callback calls esp_wifi_connect()
# which needs >2 KB stack. Default 2048 causes stack overflow on ESP32-S3.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# Wi-Fi
CONFIG_ESP_WIFI_STA_DISCONNECT_PM=n

# TLS: trust store for api.telegram.org (Let's Encrypt chain via bundle)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# LVGL (managed component)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y

# NVS encryption for secrets — RECOMMENDED for production deployment.
# When enabled, the "secrets" and "idms" NVS namespaces are encrypted at rest,
# protecting Wi-Fi credentials, Telegram tokens, and technician IDs from flash extraction.
#
# For development, encryption can be disabled. For production, enable and follow setup:
#   1. Uncomment the two lines below
#   2. Generate an NVS encryption key: python $IDF_PATH/components/nvs_flash/nvs_partition_gen/nvs_partition_gen.py generate-key ...
#   3. Burn the HMAC key eFuse: espefuse.py burn_key BLOCK_KEY_NVS_HMAC <key_file> HMAC
#   4. Flash the encrypted NVS key partition alongside your firmware
#
# WARNING: Once eFuse key is burned, it CANNOT be reversed. The device will
# permanently require this key to decrypt NVS. Test thoroughly before deploying.
#
# For development without encryption, set credentials via serial console at runtime:
#   > set_ssid MyNetwork
#   > set_pass MyPassword
#   > set_token 123456:ABC-DEF
#   > set_ota_user admin
#   > set_ota_pass secure_password
#
# CONFIG_NVS_ENCRYPTION=y
# CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=1

# OTA: enable boot tracking + rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_TEST_TIME=10

# Task Watchdog Timer — logs warnings but does NOT panic/reboot.
# Panic mode is too aggressive for a monitoring device; leave for dev debugging.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# CONFIG_ESP_TASK_WDT_PANIC is not set

# SNTP time sync for timestamps
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000
