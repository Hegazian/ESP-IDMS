"""
E-Switch TL3301AF160QG — Tactile Button
  - SPST-NO, momentary
  - 6×6 mm, through-hole
  - 160 gf actuation force
  - 4-pin (2 on each side, internally connected in pairs)
  - Pins 1-2 connected, Pins 3-4 connected
  - When pressed: pins 1/2 connected to pins 3/4
"""

#pragma experiment("TRAITS")
import has_designator_prefix
import has_part_picked

component TL3301AF160QG:
    trait has_designator_prefix<prefix="SW">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C3157", manufacturer="E-Switch", partno="TL3301AF160QG">

    # Pins 1-2 are one side (internally connected)
    signal A1 ~ pin 1
    signal A2 ~ pin 2
    # Pins 3-4 are other side (internally connected)
    signal B1 ~ pin 3
    signal B2 ~ pin 4
