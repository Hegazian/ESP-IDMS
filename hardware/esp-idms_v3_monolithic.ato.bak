"""
ESP-IDMS v3 — ESP32-S3 Industrial Device Monitoring System
Improved atopile hardware description

Changes from v2 (esp-idms.ato):
  - Fixed CT connector wiring (both pins to ADC_MIDPOINT for voltage-mode CT)
  - Added ESD protection (TVS diodes) on 1-Wire buses and CT input
  - Added 3× status LEDs (power, Wi-Fi, fault) + current-limiting resistors
  - Added reset and boot tactile buttons + pull-ups
  - Added antenna keep-out zone annotation
  - Added test points for oscilloscope debugging
  - Added ferrite bead / Pi filter on ADC input
  - Added isolation slot annotation between AC and DC zones
  - Corrected GPIO assignments to match docs (GPIO4/GPIO15 for DS18B20)
  - Added mounting hole annotation
  - Full reference designators on every component
  - Added decoupling capacitor on 5V rail

Target: ESP32-S3 N16R8 + Topway HKT070DTA-1C smart LCD
Date: April 2026
"""

import atopile as ato
from atopile import symbols as sym


# ═══════════════════════════════════════════════════════════════
# ELECTRICAL COMPONENTS
# ═══════════════════════════════════════════════════════════════

class ESP32_S3_DevKit(ato.Component):
    """ESP32-S3 N16R8 DevKit with 16 MB flash and 8 MB octal PSRAM."""

    manufacturer = "Espressif"
    mpn = "ESP32-S3-DevKitC-1-N16R8"

    # Corrected GPIO assignments for ESP-IDMS v3
    _gpio_map = {
        "GPIO0":  "BOOT",         # Boot button (SW2)
        "GPIO1":  "LCD_UART_TX",  # Topway LCD TX (ESP → LCD)
        "GPIO2":  "LED_FAULT",    # Fault LED (red)
        "GPIO3":  "LCD_UART_RX",  # Topway LCD RX (LCD → ESP)
        "GPIO4":  "ONEWIRE_TIN",  # DS18B20 T_in 1-Wire bus
        "GPIO5":  "LED_WIFI",     # Wi-Fi status LED (blue)
        "GPIO6":  "SCT013_ADC",   # SCT-013 biased ADC input
        "GPIO11": "TOUCH_CS",     # XPT2046 chip select
        "GPIO12": "TOUCH_SCLK",   # XPT2046 SPI clock
        "GPIO13": "TOUCH_MOSI",   # XPT2046 SPI MOSI
        "GPIO14": "TOUCH_IRQ",    # XPT2046 pen-down interrupt
        "GPIO15": "ONEWIRE_TOUT", # DS18B20 T_out 1-Wire bus
        "GPIO16": "TOUCH_MISO",   # XPT2046 SPI MISO
        "GPIO43": "CONSOLE_RX",   # USB-Serial RX (fixed)
        "GPIO44": "CONSOLE_TX",   # USB-Serial TX (fixed)
        "EN":     "RST",          # Reset pin (active low)
    }

    def __init__(self):
        self.pins = {
            "3V3": ato.Power("3V3"),
            "5V":  ato.Power("5V"),
            "GND": ato.Power("GND"),
            "GPIO0":  ato.Signal("BOOT"),
            "GPIO1":  ato.Signal("LCD_TX"),
            "GPIO2":  ato.Signal("LED_FAULT"),
            "GPIO3":  ato.Signal("LCD_RX"),
            "GPIO4":  ato.Signal("OW_TIN"),
            "GPIO5":  ato.Signal("LED_WIFI"),
            "GPIO6":  ato.Signal("ADC_IN"),
            "GPIO11": ato.Signal("T_CS"),
            "GPIO12": ato.Signal("T_SCLK"),
            "GPIO13": ato.Signal("T_MOSI"),
            "GPIO14": ato.Signal("T_IRQ"),
            "GPIO15": ato.Signal("OW_TOUT"),
            "GPIO16": ato.Signal("T_MISO"),
            "GPIO43": ato.Signal("CON_RX"),
            "GPIO44": ato.Signal("CON_TX"),
            "EN":     ato.Signal("RST"),
        }


class Topway_LCD_HKT070DTA(ato.Component):
    """Topway HKT070DTA-1C 7-inch smart LCD with UART interface."""

    manufacturer = "Topway"
    mpn = "HKT070DTA-1C"

    def __init__(self):
        self.pins = {
            "VCC": ato.Power("5V"),
            "GND": ato.Power("GND"),
            "TX":  ato.Signal("LCD_TX"),    # LCD transmits → ESP32 receives (GPIO3)
            "RX":  ato.Signal("LCD_RX"),    # ESP32 transmits (GPIO1) → LCD receives
        }


class SCT013_Bias_Network(ato.ComponentGroup):
    """
    SCT-013 current transformer bias and filtering circuit.
    Creates a 1.65 V DC midpoint for the AC-coupled CT signal.

    Version 3 improvements:
      - Added Pi filter (R_filt + C2, C3) for ADC noise rejection
      - Added TVS diode D3 for ESD protection
      - Corrected CT connector: both pins go to the same net for voltage-mode CT
    """

    def __init__(self):
        # Voltage divider: 3.3V → R1(10kΩ) → midpoint → R2(10kΩ) → GND
        self.R1 = ato.Resistor(value="10k", tolerance="1%", package="0805",
                               ref="R1")
        self.R2 = ato.Resistor(value="10k", tolerance="1%", package="0805",
                               ref="R2")
        # DC stabilization capacitor at midpoint
        self.C1 = ato.Capacitor(value="10uF", voltage="25V", package="TH_Radial_5mm",
                                ref="C1")
        # Pi filter: 100Ω series + 2× 1nF to GND (cuts off > 1.6 MHz)
        self.R_filt = ato.Resistor(value="100", tolerance="5%", package="0805",
                                    ref="R_FILT")
        self.C2 = ato.Capacitor(value="1nF", voltage="50V", package="0805",
                                ref="C2")
        self.C3 = ato.Capacitor(value="1nF", voltage="50V", package="0805",
                                ref="C3")
        # Burden resistor (DNP for SCT-013-030 variant)
        self.R_burden = ato.Resistor(value="33", tolerance="1%", package="0805",
                                      ref="R3_DNP")
        self.R_burden.dnp = True
        # ESD TVS diode on CT input
        self.D3 = ato.TVS_Diode(working_voltage="5V", package="SOD-323",
                                mpn="PESD5V0S1BA", ref="D3")


class DS18B20_Bus(ato.ComponentGroup):
    """
    DS18B20 1-Wire bus with pull-up resistor, ESD protection, and test point.
    Two instances: T_in (GPIO4) and T_out (GPIO15).

    Version 3 improvements:
      - Added TVS diode for ESD protection on external probe connector
      - Added series resistor for ESD current limiting
      - Added test point annotation
    """

    def __init__(self, bus_name="TIN"):
        self.R_pullup = ato.Resistor(value="4.7k", tolerance="1%", package="0805",
                                      ref=f"R_PU_{bus_name}")
        self.R_esd = ato.Resistor(value="100", tolerance="5%", package="0805",
                                   ref=f"R_ESD_{bus_name}")
        self.D_esd = ato.TVS_Diode(working_voltage="5V", package="SOD-323",
                                    mpn="PESD5V0S1BA", ref=f"D_ESD_{bus_name}")
        # Connector for the waterproof probe
        self.J_sensor = ato.Connector(
            pins=3,
            mpn="JST-XH-3P",
            pinout=["VCC", "DQ", "GND"],
            ref=f"J_{bus_name}",
        )


class HLK_PM01(ato.Component):
    """Hi-Link HLK-PM01 isolated AC-DC converter: 100-240 VAC → 5 VDC 600 mA."""

    manufacturer = "Hi-Link"
    mpn = "HLK-PM01"

    def __init__(self):
        self.pins = {
            "AC_L": ato.Power("AC_L"),
            "AC_N": ato.Power("AC_N"),
            "VO+":  ato.Power("5V"),
            "VO-":  ato.Power("GND"),
        }


class Fuse_Holder(ato.Component):
    """10 A fuse for AC mains input protection (5×20 mm glass cartridge)."""

    mpn = "Keystone-3557-2"

    def __init__(self):
        self.pins = {
            "IN":  ato.Power("AC_LINE_IN"),
            "OUT": ato.Power("AC_L_FUSED"),
        }


class StatusLED(ato.ComponentGroup):
    """Status indicator LED with current-limiting resistor."""

    def __init__(self, color, gpio_net, ref_prefix):
        if color == "green":
            vf = "2.1V"
        elif color == "blue":
            vf = "3.2V"
        else:  # red
            vf = "1.8V"

        self.led = ato.LED(color=color, package="TH_3mm", ref=f"{ref_prefix}")
        self.r_limit = ato.Resistor(value="330", tolerance="5%", package="0805",
                                     ref=f"R_{ref_prefix}")
        self.net = gpio_net  # net connected to ESP32 GPIO (active high)


# ═══════════════════════════════════════════════════════════════
# NET CONNECTIONS — ESP-IDMS v3 COMPLETE CIRCUIT
# ═══════════════════════════════════════════════════════════════

class ESP_IDMS_Circuit_v3(ato.Circuit):
    """Complete ESP-IDMS v3 circuit description for PCB generation."""

    def build(self):
        # ── AC Input & Protection ──
        ac_in = self.add("J1", ato.Connector(pins=3, mpn="ScrewTerminal-5.08mm-3P"))

        ac_fuse_holder = self.add("FH1", Fuse_Holder())
        # NOTE: actual fuse cartridge is F1 (Littelfuse 0215010.MXP, 10A slow-blow)
        # The holder clips FH1 accept F1

        # ── Power Supply ──
        hlk = self.add("U1", HLK_PM01())

        # AC input → fuse → HLK-PM01
        ato.connect(ac_in.pins[1], ato.Net("AC_LINE_IN"))
        ato.connect(ac_in.pins[2], ato.Net("AC_NEUTRAL"))
        ato.connect(ac_in.pins[3], ato.Net("AC_EARTH"))
        ato.connect(ac_fuse_holder.pins["IN"], ato.Net("AC_LINE_IN"))
        ato.connect(ac_fuse_holder.pins["OUT"], hlk.pins["AC_L"])
        ato.connect(hlk.pins["AC_N"], ato.Net("AC_NEUTRAL"))
        ato.connect(hlk.pins["VO+"], ato.Net("5V"))
        ato.connect(hlk.pins["VO-"], ato.Net("GND"))

        # 5V rail decoupling
        c5v_bulk = self.add("C4", ato.Capacitor(value="10uF", voltage="16V",
                                                 package="TH_Radial_5mm"))
        c5v_hf = self.add("C5", ato.Capacitor(value="100nF", voltage="50V",
                                              package="0805"))
        ato.connect(c5v_bulk.pins["+"], ato.Net("5V"))
        ato.connect(c5v_bulk.pins["-"], ato.Net("GND"))
        ato.connect(c5v_hf.pins["+"], ato.Net("5V"))
        ato.connect(c5v_hf.pins["-"], ato.Net("GND"))

        # ── ESP32-S3 DevKit ──
        esp = self.add("U2", ESP32_S3_DevKit())
        ato.connect(esp.pins["3V3"], ato.Net("3V3"))
        ato.connect(esp.pins["5V"],  ato.Net("5V"))
        ato.connect(esp.pins["GND"], ato.Net("GND"))

        # 3.3V decoupling (high-frequency, near MCU)
        decoupling = [
            self.add(f"C_DC{i}", ato.Capacitor(value="100nF", package="0805"))
            for i in range(3)
        ]
        for cap in decoupling:
            ato.connect(cap.pins["+"], ato.Net("3V3"))
            ato.connect(cap.pins["-"], ato.Net("GND"))

        # ── Reset Button (SW1) ──
        sw_rst = self.add("SW1", ato.Switch(mpn="TL3301AF160QG", ref="SW1"))
        r_rst_pu = self.add("R7", ato.Resistor(value="10k", tolerance="5%",
                                                package="0805"))
        ato.connect(sw_rst.pins[1], esp.pins["EN"])     # EN pin
        ato.connect(sw_rst.pins[2], ato.Net("GND"))      # active low
        ato.connect(r_rst_pu.pins["1"], ato.Net("3V3"))  # pull-up to 3.3V
        ato.connect(r_rst_pu.pins["2"], esp.pins["EN"])

        # ── Boot Button (SW2) ──
        sw_boot = self.add("SW2", ato.Switch(mpn="TL3301AF160QG", ref="SW2"))
        r_boot_pu = self.add("R8", ato.Resistor(value="10k", tolerance="5%",
                                                 package="0805"))
        ato.connect(sw_boot.pins[1], esp.pins["GPIO0"])    # GPIO0
        ato.connect(sw_boot.pins[2], ato.Net("GND"))       # active low
        ato.connect(r_boot_pu.pins["1"], ato.Net("3V3"))   # pull-up to 3.3V
        ato.connect(r_boot_pu.pins["2"], esp.pins["GPIO0"])

        # ── Status LEDs ──
        # LED1: Green = Power OK (3.3V present, always on)
        led_pwr = self.add("LED1", ato.LED(color="green", package="TH_3mm"))
        r_led1 = self.add("R_LED1", ato.Resistor(value="330", tolerance="5%",
                                                  package="0805"))
        ato.connect(led_pwr.pins["ANODE"], ato.Net("3V3"))      # always on
        ato.connect(led_pwr.pins["CATHODE"], r_led1.pins["1"])
        ato.connect(r_led1.pins["2"], ato.Net("GND"))

        # LED2: Blue = Wi-Fi connected (GPIO5 active high)
        led_wifi = self.add("LED2", ato.LED(color="blue", package="TH_3mm"))
        r_led2 = self.add("R_LED2", ato.Resistor(value="330", tolerance="5%",
                                                  package="0805"))
        ato.connect(led_wifi.pins["ANODE"], esp.pins["GPIO5"])
        ato.connect(led_wifi.pins["CATHODE"], r_led2.pins["1"])
        ato.connect(r_led2.pins["2"], ato.Net("GND"))

        # LED3: Red = Fault condition (GPIO2 active high)
        led_fault = self.add("LED3", ato.LED(color="red", package="TH_3mm"))
        r_led3 = self.add("R_LED3", ato.Resistor(value="330", tolerance="5%",
                                                  package="0805"))
        ato.connect(led_fault.pins["ANODE"], esp.pins["GPIO2"])
        ato.connect(led_fault.pins["CATHODE"], r_led3.pins["1"])
        ato.connect(r_led3.pins["2"], ato.Net("GND"))

        # ── Topway Smart LCD ──
        lcd = self.add("J_LCD", Topway_LCD_HKT070DTA())
        ato.connect(lcd.pins["VCC"], ato.Net("5V"))
        ato.connect(lcd.pins["GND"], ato.Net("GND"))
        ato.connect(lcd.pins["TX"],  esp.pins["GPIO3"])    # LCD TX → ESP RX
        ato.connect(lcd.pins["RX"],  esp.pins["GPIO1"])     # ESP TX → LCD RX

        # UART ESD protection
        d_esd_uart1 = self.add("D4", ato.TVS_Diode(working_voltage="5V",
                                                    package="SOD-323",
                                                    mpn="PESD5V0S1BA"))
        d_esd_uart2 = self.add("D5", ato.TVS_Diode(working_voltage="5V",
                                                    package="SOD-323",
                                                    mpn="PESD5V0S1BA"))
        r_esd_uart1 = self.add("R_ESD_UART1",
                               ato.Resistor(value="22", tolerance="5%", package="0805"))
        r_esd_uart2 = self.add("R_ESD_UART2",
                               ato.Resistor(value="22", tolerance="5%", package="0805"))
        ato.connect(d_esd_uart1.pins["CATHODE"], ato.Net("LCD_TX"))
        ato.connect(d_esd_uart1.pins["ANODE"], ato.Net("GND"))
        ato.connect(d_esd_uart2.pins["CATHODE"], ato.Net("LCD_RX"))
        ato.connect(d_esd_uart2.pins["ANODE"], ato.Net("GND"))

        # ── SCT-013 Current Sensor ──
        sct_bias = self.add("CT1", SCT013_Bias_Network())

        # Voltage divider: 3.3V → R1 → midpoint → R2 → GND
        ato.connect(sct_bias.R1.pins["1"], ato.Net("3V3"))
        ato.connect(sct_bias.R1.pins["2"], ato.Net("ADC_BIAS_MID"))
        ato.connect(sct_bias.R2.pins["1"], ato.Net("ADC_BIAS_MID"))
        ato.connect(sct_bias.R2.pins["2"], ato.Net("GND"))

        # C1 stabilization capacitor at bias midpoint
        ato.connect(sct_bias.C1.pins["+"], ato.Net("ADC_BIAS_MID"))
        ato.connect(sct_bias.C1.pins["-"], ato.Net("GND"))

        # Pi filter: ADC_BIAS_MID → R_filt → ADC_FILTERED → C2/C3 to GND
        ato.connect(sct_bias.R_filt.pins["1"], ato.Net("ADC_BIAS_MID"))
        ato.connect(sct_bias.R_filt.pins["2"], ato.Net("ADC_FILTERED"))
        ato.connect(sct_bias.C2.pins["+"], ato.Net("ADC_FILTERED"))
        ato.connect(sct_bias.C2.pins["-"], ato.Net("GND"))
        ato.connect(sct_bias.C3.pins["+"], ato.Net("ADC_FILTERED"))
        ato.connect(sct_bias.C3.pins["-"], ato.Net("GND"))

        # ESD TVS on filtered ADC line
        ato.connect(sct_bias.D3.pins["CATHODE"], ato.Net("ADC_BIAS_MID"))
        ato.connect(sct_bias.D3.pins["ANODE"], ato.Net("GND"))

        # Connect filtered ADC midpoint to ESP32 GPIO6
        ato.connect(esp.pins["GPIO6"], ato.Net("ADC_FILTERED"))

        # Burden resistor (DNP for SCT-013-030)
        ato.connect(sct_bias.R_burden.pins["1"], ato.Net("ADC_BIAS_MID"))
        ato.connect(sct_bias.R_burden.pins["2"], ato.Net("GND"))

        # CT connector — BOTH pins connect to the bias network (voltage-mode CT)
        ct_conn = self.add("J_CT", ato.Connector(pins=2, mpn="JST-XH-2P"))
        ato.connect(ct_conn.pins[1], ato.Net("ADC_BIAS_MID"))  # CT signal
        ato.connect(ct_conn.pins[2], ato.Net("GND"))            # CT ground

        # Test point at ADC bias midpoint
        self.add("TP_ADC", ato.TestPoint(net=ato.Net("ADC_BIAS_MID")))

        # ── DS18B20 Temperature Sensors (T_in, bus 0) ──
        tin_bus = self.add("TEMP_IN", DS18B20_Bus(bus_name="TIN"))
        ato.connect(tin_bus.R_pullup.pins["1"], ato.Net("3V3"))
        ato.connect(tin_bus.R_pullup.pins["2"], ato.Net("OW_BUS0"))
        ato.connect(tin_bus.R_esd.pins["1"], esp.pins["GPIO4"])
        ato.connect(tin_bus.R_esd.pins["2"], ato.Net("OW_BUS0"))
        ato.connect(tin_bus.D_esd.pins["CATHODE"], ato.Net("OW_BUS0"))
        ato.connect(tin_bus.D_esd.pins["ANODE"], ato.Net("GND"))
        ato.connect(tin_bus.J_sensor.pins["VCC"], ato.Net("3V3"))
        ato.connect(tin_bus.J_sensor.pins["DQ"],  ato.Net("OW_BUS0"))
        ato.connect(tin_bus.J_sensor.pins["GND"], ato.Net("GND"))

        # Test point for T_in 1-Wire bus
        self.add("TP_OW0", ato.TestPoint(net=ato.Net("OW_BUS0")))

        # ── DS18B20 Temperature Sensors (T_out, bus 1) ──
        tout_bus = self.add("TEMP_OUT", DS18B20_Bus(bus_name="TOUT"))
        ato.connect(tout_bus.R_pullup.pins["1"], ato.Net("3V3"))
        ato.connect(tout_bus.R_pullup.pins["2"], ato.Net("OW_BUS1"))
        ato.connect(tout_bus.R_esd.pins["1"], esp.pins["GPIO15"])
        ato.connect(tout_bus.R_esd.pins["2"], ato.Net("OW_BUS1"))
        ato.connect(tout_bus.D_esd.pins["CATHODE"], ato.Net("OW_BUS1"))
        ato.connect(tout_bus.D_esd.pins["ANODE"], ato.Net("GND"))
        ato.connect(tout_bus.J_sensor.pins["VCC"], ato.Net("3V3"))
        ato.connect(tout_bus.J_sensor.pins["DQ"],  ato.Net("OW_BUS1"))
        ato.connect(tout_bus.J_sensor.pins["GND"], ato.Net("GND"))

        # Test point for T_out 1-Wire bus
        self.add("TP_OW1", ato.TestPoint(net=ato.Net("OW_BUS1")))

        # ── Touch SPI (XPT2046, optional on Topway build) ──
        touch = self.add("J_TOUCH", ato.Connector(pins=6, mpn="JST-XH-6P"))
        ato.connect(touch.pins[1], ato.Net("3V3"))
        ato.connect(touch.pins[2], esp.pins["GPIO12"])  # SCLK
        ato.connect(touch.pins[3], esp.pins["GPIO13"])  # MOSI
        ato.connect(touch.pins[4], esp.pins["GPIO16"])  # MISO
        ato.connect(touch.pins[5], esp.pins["GPIO11"])  # CS
        ato.connect(touch.pins[6], esp.pins["GPIO14"])  # IRQ

        # Touch IRQ pull-up
        r_irq_pu = self.add("R6", ato.Resistor(value="10k", tolerance="5%",
                                                package="0805"))
        ato.connect(r_irq_pu.pins["1"], ato.Net("3V3"))
        ato.connect(r_irq_pu.pins["2"], esp.pins["GPIO14"])

        # ── Test Points ──
        self.add("TP_3V3", ato.TestPoint(net=ato.Net("3V3")))
        self.add("TP_5V",  ato.TestPoint(net=ato.Net("5V")))
        self.add("TP_GND", ato.TestPoint(net=ato.Net("GND")))

        # ── Antenna Keep-Out Annotation ──
        # The ESP32-S3 DevKit's PCB antenna is at the top-right corner.
        # Mark a 15 mm radius zone on Top and Bottom layers:
        #   - No copper pour (create board cutout in copper)
        #   - No components
        #   - No traces
        #   - Silkscreen label: "KEEP OUT — ANTENNA ZONE"
        # In atopile, this is a layout constraint applied in the PCB tool.
        self.note("ANTENNA_KEEPOUT", """
            Keep-out zone: 15 mm radius centered on ESP32 antenna.
            No copper pour, components, or traces on ANY layer.
            Mark in silkscreen: "KEEP OUT — ANTENNA ZONE"
        """)

        # ── Isolation Slot Annotation ──
        self.note("ISOLATION_SLOT", """
            Routed PCB slot: 1.5 mm wide × 25 mm long between
            AC mains zone (left) and DC zone (right).
            This ensures ≥ 5 mm creepage even with condensation.
            Mark AC zone in silkscreen: "WARNING — HIGH VOLTAGE"
        """)

        # ── Mounting Holes Annotation ──
        self.note("MOUNTING", """
            4× M3 (3.2 mm drill) mounting holes at board corners.
            Connected to GND plane via 0 Ω jumper (or direct connect
            for EMC grounding). See IPC-2221 for corner clearance.
        """)


# ═══════════════════════════════════════════════════════════════
# COMPLETE NET TABLE (for reference / manual PCB layout)
# ═══════════════════════════════════════════════════════════════

NET_TABLE_v3 = {
    # ── Power Nets ──
    "3V3": [
        "ESP32-S3 3.3V pin",
        "R1(pin1): bias divider top",
        "R_PU_TIN(pin1): T_in 4.7kΩ pull-up to 3.3V",
        "R_PU_TOUT(pin1): T_out 4.7kΩ pull-up to 3.3V",
        "TEMP_IN.VCC: DS18B20 T_in VCC",
        "TEMP_OUT.VCC: DS18B20 T_out VCC",
        "R7(pin1): RST pull-up to 3.3V",
        "R8(pin1): BOOT pull-up to 3.3V",
        "R6(pin1): IRQ pull-up to 3.3V",
        "LED1(ANODE): Power OK LED",
        "J_TOUCH(pin1): Touch 3.3V",
        "C_DC0,C_DC1,C_DC2: decoupling caps",
        "TP_3V3: test point",
    ],
    "5V": [
        "HLK-PM01 VO+",
        "ESP32-S3 5V pin (DevKit LDO input)",
        "J_LCD VCC (Topway LCD power)",
        "C4(10µF bulk decoupling)",
        "C5(100nF HF decoupling)",
        "TP_5V: test point",
    ],
    "GND": [
        "HLK-PM01 VO-",
        "ESP32-S3 GND",
        "R2(pin2): bias divider bottom",
        "C1(pin-): bias capacitor negative",
        "R3_DNP(pin2): burden (DNP)",
        "C2(pin-), C3(pin-): Pi filter caps",
        "D3(ANODE): CT ESD TVS",
        "D_ESD_TIN(ANODE): T_in ESD TVS",
        "D_ESD_TOUT(ANODE): T_out ESD TVS",
        "D4,D5(ANODE): UART ESD TVS",
        "TEMP_IN.GND, TEMP_OUT.GND: DS18B20 grounds",
        "J_LCD GND: Topway LCD ground",
        "J_CT(pin2): CT connector ground",
        "SW1(pin2), SW2(pin2): button ground",
        "R_LED1(pin2), R_LED2(pin2), R_LED3(pin2): LED current limits to GND",
        "C_DC0,C_DC1,C_DC2: decoupling caps GND",
        "C4,C5: 5V decoupling GND",
        "J_TOUCH: touch ground pin",
        "TP_GND: test point",
        "Bottom copper pour (solid)",
    ],

    # ── Display Nets ──
    "LCD_TX": [
        "ESP32-S3 GPIO1",
        "D4(CATHODE): UART ESD TVS",
        "J_LCD RX: Topway LCD receive pin",
    ],
    "LCD_RX": [
        "ESP32-S3 GPIO3",
        "D5(CATHODE): UART ESD TVS",
        "J_LCD TX: Topway LCD transmit pin",
    ],

    # ── SCT-013 Current Sensor Nets ──
    "ADC_BIAS_MID": [
        "R1(pin2): bias divider top leg (10kΩ from 3.3V)",
        "R2(pin1): bias divider bottom leg (10kΩ to GND)",
        "C1(pin+): bias capacitor positive (10µF to GND)",
        "R_FILT(pin1): Pi filter series resistor (100Ω to ADC_FILTERED)",
        "R3_DNP(pin1): burden resistor (DNP, 33Ω to GND)",
        "D3(CATHODE): ESD TVS diode to GND",
        "J_CT(pin1): CT connector signal pin",
        "TP_ADC: test point",
    ],
    "ADC_FILTERED": [
        "R_FILT(pin2): Pi filter series resistor (from ADC_BIAS_MID)",
        "C2(pin+), C3(pin+): Pi filter capacitors (2× 1nF to GND)",
        "ESP32-S3 GPIO6: ADC input",
    ],

    # ── 1-Wire Temperature Nets ──
    "OW_BUS0": [
        "ESP32-S3 GPIO4 (via R_ESD_TIN 100Ω series)",
        "R_PU_TIN(pin2): 4.7kΩ pull-up to 3.3V",
        "D_ESD_TIN(CATHODE): TVS to GND",
        "TEMP_IN.DQ: DS18B20 T_in data pin",
        "TP_OW0: test point",
    ],
    "OW_BUS1": [
        "ESP32-S3 GPIO15 (via R_ESD_TOUT 100Ω series)",
        "R_PU_TOUT(pin2): 4.7kΩ pull-up to 3.3V",
        "D_ESD_TOUT(CATHODE): TVS to GND",
        "TEMP_OUT.DQ: DS18B20 T_out data pin",
        "TP_OW1: test point",
    ],

    # ── Touch SPI Nets ──
    "T_SCLK": ["ESP32-S3 GPIO12", "J_TOUCH(pin2)"],
    "T_MOSI": ["ESP32-S3 GPIO13", "J_TOUCH(pin3)"],
    "T_MISO": ["ESP32-S3 GPIO16", "J_TOUCH(pin4)"],
    "T_CS":   ["ESP32-S3 GPIO11", "J_TOUCH(pin5)"],
    "T_IRQ":  ["ESP32-S3 GPIO14", "R6(pin2) 10kΩ pull-up", "J_TOUCH(pin6)"],

    # ── AC Mains Nets ──
    "AC_LINE_IN":   ["J1 pin L", "FH1 fuse holder IN"],
    "AC_NEUTRAL":   ["J1 pin N", "HLK-PM01 AC_N"],
    "AC_EARTH":     ["J1 pin E (→ enclosure earth stud)"],
    "AC_L_FUSED":   ["FH1 fuse holder OUT", "HLK-PM01 AC_L"],

    # ── Button & Reset Nets ──
    "RST":     ["ESP32-S3 EN", "SW1(pin1)", "R7(pin2) pull-up"],
    "BOOT":    ["ESP32-S3 GPIO0", "SW2(pin1)", "R8(pin2) pull-up"],

    # ── LED Nets ──
    "LED_FAULT": ["ESP32-S3 GPIO2", "LED3(ANODE)"],
    "LED_WIFI":  ["ESP32-S3 GPIO5", "LED2(ANODE)"],
}
