"""
Connector Modules

Wraps atomic connector parts into modules with proper power/signal interfaces:
  - J_AC_IN: 3-pin screw terminal (AC mains: L, N, E)
  - J_LCD:   4-pin JST-XH right-angle (Topway LCD: 5V, GND, TX, RX)
  - J_CT:    2-pin JST-XH right-angle (SCT-013 CT: signal+, GND)
  - J_TEMP:  3-pin JST-XH right-angle (DS18B20: VCC, DQ, GND)
  - J_TOUCH: 6-pin JST-XH right-angle (XPT2046 touch SPI + IRQ)
  - J_MCU:   1×19 female header (ESP32 DevKit socket, 2× strips)
"""

#pragma experiment("TRAITS")
import Electrical
import ElectricPower
from "parts/screw_terminal/ScrewTerminal_3P.ato" import ScrewTerminal_3P
from "parts/jst_xh/JST_XH.ato" import JST_XH_4P_RA
from "parts/jst_xh/JST_XH.ato" import JST_XH_3P_RA
from "parts/jst_xh/JST_XH.ato" import JST_XH_2P_RA
from "parts/jst_xh/JST_XH.ato" import JST_XH_6P_RA
from "parts/pin_header/PinHeader_1x19_Female.ato" import PinHeader_1x19_Female

module AC_Input_Connector:
    """3-pin screw terminal for AC mains (L, N, E). HV zone — keep isolated."""
    package = new ScrewTerminal_3P
    signal ac_l ~ package.1      # AC Live
    signal ac_n ~ package.2      # AC Neutral
    signal ac_e ~ package.3      # AC Earth

module LCD_Connector_4P:
    """4-pin JST-XH for Topway LCD: 5V, GND, TX, RX."""
    package = new JST_XH_4P_RA
    power = new ElectricPower
    signal tx ~ package.3        # LCD UART TX (→ MCU RX)
    signal rx ~ package.4        # LCD UART RX (← MCU TX)
    power.hv ~ package.1         # 5V
    power.lv ~ package.2         # GND

module CT_Connector_2P:
    """2-pin JST-XH for SCT-013 CT: signal, GND."""
    package = new JST_XH_2P_RA
    signal sig ~ package.1       # CT signal (to bias midpoint)
    signal gnd ~ package.2       # CT ground

module Temp_Connector_3P:
    """3-pin JST-XH for DS18B20 probe: VCC, DQ, GND."""
    package = new JST_XH_3P_RA
    power = new ElectricPower
    signal dq ~ package.2        # 1-Wire data
    power.hv ~ package.1         # 3.3V VCC
    power.lv ~ package.3         # GND

module Touch_Connector_6P:
    """6-pin JST-XH for XPT2046 touch SPI breakout."""
    package = new JST_XH_6P_RA
    signal sclk ~ package.1
    signal mosi ~ package.2
    signal miso ~ package.3
    signal cs   ~ package.4
    signal irq  ~ package.5
    signal gnd  ~ package.6

module MCU_Socket_1x19:
    """1×19 female header for ESP32 DevKit socket."""
    package = new PinHeader_1x19_Female
    pins = new Electrical[19]
    pins[0] ~ package.1
    pins[1] ~ package.2
    pins[2] ~ package.3
    pins[3] ~ package.4
    pins[4] ~ package.5
    pins[5] ~ package.6
    pins[6] ~ package.7
    pins[7] ~ package.8
    pins[8] ~ package.9
    pins[9] ~ package.10
    pins[10] ~ package.11
    pins[11] ~ package.12
    pins[12] ~ package.13
    pins[13] ~ package.14
    pins[14] ~ package.15
    pins[15] ~ package.16
    pins[16] ~ package.17
    pins[17] ~ package.18
    pins[18] ~ package.19
