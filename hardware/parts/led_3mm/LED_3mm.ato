"""
Through-Hole 3 mm LEDs — Lite-On LTL-423x Series
  - LTL-4231N: Green, Vf=2.1 V, 20 mA max
  - LTL-4233:  Blue,  Vf=3.2 V, 20 mA max
  - LTL-4234:  Red,   Vf=1.8 V, 20 mA max
  - Through-hole, 3 mm diameter, 2-pin (anode/cathode)
"""

#pragma experiment("TRAITS")
import has_designator_prefix
import has_part_picked

component LED_3mm_Green:
    trait has_designator_prefix<prefix="LED">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C72039", manufacturer="Lite-On", partno="LTL-4231N">
    signal ANODE ~ pin 1
    signal CATHODE ~ pin 2

component LED_3mm_Blue:
    trait has_designator_prefix<prefix="LED">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C2290", manufacturer="Lite-On", partno="LTL-4233">
    signal ANODE ~ pin 1
    signal CATHODE ~ pin 2

component LED_3mm_Red:
    trait has_designator_prefix<prefix="LED">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C72041", manufacturer="Lite-On", partno="LTL-4234">
    signal ANODE ~ pin 1
    signal CATHODE ~ pin 2
