menu "ESP-IDMS Configuration"

    config IDMS_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config IDMS_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config IDMS_TELEGRAM_BOT_TOKEN
        string "Telegram bot token (empty disables outbound messages)"
        default ""

    config IDMS_DEFAULT_TECH_CHAT_ID
        string "Default technician Telegram chat_id (copied to NVS on first boot if empty)"
        default ""
        help
            Optional default technician chat ID. If empty, add technicians via serial console or Telegram.

    config IDMS_CURRENT_THRESHOLD_MA
        int "RMS current below this = machine off (milliamps)"
        range 50 5000
        default 350

    config IDMS_CT_AMPS_PER_VOLT_X100
        int "Calibration: RMS amps per volt at ADC, fixed-point x100 (3000 = 30.00 A/V)"
        range 10 500000
        default 3000

    config IDMS_SCT_AUTOZERO_ENABLE
        bool "Enable SCT-013 auto-zero calibration"
        default y
        help
            When enabled, the monitor samples the ADC at startup with no load
            to determine the noise floor (RMS offset). This offset is subtracted
            from all subsequent current readings to improve low-current accuracy.
            Disable if you do not have a no-load startup condition.

    config IDMS_SCT_AUTOZERO_SAMPLES
        int "Auto-zero sample count"
        range 64 4096
        default 512
        depends on IDMS_SCT_AUTOZERO_ENABLE
        help
            Number of ADC samples to collect for auto-zero calibration.
            More samples = better accuracy but longer startup time.

    config IDMS_DT_LOW_C
        int "Cooling fault: delta-T below (°C)"
        range 1 20
        default 5

    config IDMS_DT_HIGH_C
        int "Cooling fault: delta-T above (°C)"
        range 10 80
        default 15

    # ------------------------------------------------------------------
    #  ADC / Current sensor GPIO — defaults differ per target
    # ------------------------------------------------------------------

    config IDMS_ADC_GPIO
        int "GPIO for SCT-013 biased ADC input (must be ADC-capable on this chip)"
        range 0 48
        default 34 if IDF_TARGET_ESP32
        default 6 if IDF_TARGET_ESP32S3

    choice IDMS_TEMP_SENSOR
        prompt "Temperature sensor type"
        default IDMS_TEMP_SENSOR_MAX31865

        config IDMS_TEMP_SENSOR_DS18B20
            bool "DS18B20 1-Wire digital sensor"
            help
                Original DS18B20 waterproof probes on shared 1-Wire bus.
                Uses a configurable GPIO with 4.7K pull-up.

        config IDMS_TEMP_SENSOR_MAX31865
            bool "PT100 RTD via MAX31865 SPI"
            help
                PT100/PT1000 RTD sensors connected via MAX31865 RTD-to-digital converters.
                Two MAX31865 chips on dedicated SPI bus for T_in and T_out.
                Higher accuracy (±0.1°C) and industrial-grade reliability.

        config IDMS_TEMP_SENSOR_PT100_ADC
            bool "PT100 RTD via ADC (single sensor)"
            help
                Single PT100 RTD read directly through ESP32 ADC using a voltage
                divider with a precision reference resistor.
                Provides T_in only (no T_out). Delta-T unavailable.
                Lower accuracy (±1-2°C) but no extra IC needed.

        config IDMS_TEMP_SENSOR_DS18B20_PT100
            bool "DS18B20 + PT100 ADC combo"
            help
                Mixed sensor setup: DS18B20 digital probes and PT100 RTD via ADC.
                Configure which sensor type maps to T_in and T_out below.
    endchoice

    config IDMS_PIN_ONEWIRE
        int "DS18B20 1-Wire GPIO for T_in sensor"
        range 0 48
        default 4 if IDF_TARGET_ESP32S3
        default 4 if IDF_TARGET_ESP32
        default 4
        depends on IDMS_TEMP_SENSOR_DS18B20 || IDMS_TEMP_SENSOR_DS18B20_PT100

    config IDMS_PIN_ONEWIRE2
        int "DS18B20 1-Wire GPIO for T_out sensor"
        range 0 48
        default 15 if IDF_TARGET_ESP32S3
        default 17 if IDF_TARGET_ESP32
        default 15
        depends on IDMS_TEMP_SENSOR_DS18B20 || IDMS_TEMP_SENSOR_DS18B20_PT100
        help
            Dedicated GPIO for the second DS18B20 sensor (T_out).
            Must be DIFFERENT from the T_in pin. Each sensor has its own
            1-Wire bus with its own pull-up resistor — no shared bus.

    config IDMS_MAX31865_CS0
        int "MAX31865 chip-select GPIO for T_in sensor"
        range 0 48
        default 7 if IDF_TARGET_ESP32S3
        default 5 if IDF_TARGET_ESP32
        default 7
        depends on IDMS_TEMP_SENSOR_MAX31865

    config IDMS_MAX31865_CS1
        int "MAX31865 chip-select GPIO for T_out sensor"
        range 0 48
        default 16
        depends on IDMS_TEMP_SENSOR_MAX31865

    config IDMS_MAX31865_SPI_CLK_KHZ
        int "MAX31865 SPI clock speed (kHz)"
        range 100 5000
        default 1000
        depends on IDMS_TEMP_SENSOR_MAX31865

    config IDMS_MAX31865_RREF_X10
        int "Reference resistor value x10 (430 = 43.0 ohm for PT100, 4300 = 430.0 for PT1000)"
        range 100 43000
        default 4300
        depends on IDMS_TEMP_SENSOR_MAX31865
        help
            RREF reference resistor on the MAX31865 board, multiplied by 10.
            For PT100 with 430 ohm reference: enter 4300.
            For PT100 with 400 ohm reference: enter 4000.
            Check your MAX31865 breakout board's reference resistor value.

    choice IDMS_MAX31865_WIRE
        prompt "RTD wire mode"
        default IDMS_MAX31865_WIRE_3
        depends on IDMS_TEMP_SENSOR_MAX31865

        config IDMS_MAX31865_WIRE_2
            bool "2-wire RTD"
        config IDMS_MAX31865_WIRE_3
            bool "3-wire RTD"
        config IDMS_MAX31865_WIRE_4
            bool "4-wire RTD"
    endchoice

    config IDMS_PIN_PT100_ADC
        int "PT100 ADC GPIO (must be ADC-capable)"
        range 0 48
        default 15 if IDF_TARGET_ESP32S3
        default 13 if IDF_TARGET_ESP32
        default 15
        depends on IDMS_TEMP_SENSOR_PT100_ADC || IDMS_TEMP_SENSOR_DS18B20_PT100
        help
            ADC input GPIO reading the PT100 voltage divider midpoint.
            MUST be on a DIFFERENT ADC unit from the SCT-013 current sensor
            to avoid sharing the ADC bus.
            ESP32-S3: SCT-013 defaults to ADC1 (GPIO 6). Use ADC2 (GPIO 11-20) for PT100.
            ESP32: SCT-013 defaults to ADC1 (GPIO 34). Use ADC2 (GPIO 0,2,4,12-15,25-27) for PT100.

    config IDMS_PT100_RREF_X10
        int "Reference resistor value x10 ohms (e.g. 1500 = 150.0Ω)"
        range 100 100000
        default 1500
        depends on IDMS_TEMP_SENSOR_PT100_ADC || IDMS_TEMP_SENSOR_DS18B20_PT100
        help
            R_ref in the voltage divider, multiplied by 10.
            Common values: 150Ω (1500), 220Ω (2200), 330Ω (3300),
            470Ω (4700), 1kΩ (10000).

    config IDMS_PT100_R0_X10
        int "PT100 nominal resistance at 0°C x10 (1000 = 100.0Ω for PT100)"
        range 500 100000
        default 1000
        depends on IDMS_TEMP_SENSOR_PT100_ADC || IDMS_TEMP_SENSOR_DS18B20_PT100
        help
            Nominal RTD resistance at 0°C, multiplied by 10.
            PT100 = 1000, PT1000 = 10000.

    choice IDMS_COMBO_T_IN
        prompt "T_in sensor type (DS18B20 + PT100 combo)"
        default IDMS_COMBO_T_IN_DS18B20
        depends on IDMS_TEMP_SENSOR_DS18B20_PT100

        config IDMS_COMBO_T_IN_DS18B20
            bool "DS18B20 digital probe"
        config IDMS_COMBO_T_IN_PT100
            bool "PT100 RTD via ADC"
    endchoice

    choice IDMS_COMBO_T_OUT
        prompt "T_out sensor type (DS18B20 + PT100 combo)"
        default IDMS_COMBO_T_OUT_DS18B20
        depends on IDMS_TEMP_SENSOR_DS18B20_PT100

        config IDMS_COMBO_T_OUT_DS18B20
            bool "DS18B20 digital probe"
        config IDMS_COMBO_T_OUT_PT100
            bool "PT100 RTD via ADC"
    endchoice

    config IDMS_PIN_PT100_ADC2
        int "Second PT100 ADC GPIO for T_out (-1 if same as T_in)"
        range -1 48
        default -1
        depends on IDMS_TEMP_SENSOR_DS18B20_PT100 && IDMS_COMBO_T_OUT_PT100
        help
            If T_out also uses PT100 ADC, set this to a different ADC GPIO.
            Set to -1 if both T_in and T_out share the same PT100 (not recommended).

    # ------------------------------------------------------------------
    #  Display — controller choice applies to both targets
    # ------------------------------------------------------------------

choice IDMS_DISPLAY_CONTROLLER
        prompt "LCD display controller"
        default IDMS_DISPLAY_ST7796S

        config IDMS_DISPLAY_ILI9341
            bool "ILI9341 (2.8\" 320x240)"
            help
                Original 2.8" 320x240 ILI9341 SPI TFT display with XPT2046 resistive touch.
                Uses managed component espressim/esp_lcd_ili9341.

        config IDMS_DISPLAY_ST7796S
            bool "ST7796/S (3.5\" 320x480)"
            help
                3.5" 320x480 ST7796/ST7796S TFT display.
                Uses built-in driver in components/drivers/esp_lcd_st7796s.
                Supports both SPI (4-wire) and I80 (8080 parallel) interface.

        config IDMS_DISPLAY_ILI9488
            bool "ILI9488 (3.5\" 320x480)"
            help
                3.5" 320x480 ILI9488 TFT display.
                Alternative controller found on some 3.5" modules.
                Uses built-in driver in components/drivers/esp_lcd_ili9488.

        config IDMS_DISPLAY_TOPWAY
            bool "Topway Smart LCD (UART, 800x480)"
            help
                Topway Smart LCD module with built-in graphics engine.
                Uses UART serial interface with command protocol.
                800x480 resolution. Does NOT use LVGL - uses Topway native commands.
                Set IM pins to 111 if using SPI mode on the display.
    endchoice

    # ------------------------------------------------------------------
    #  Display bus interface — SPI (4-wire) or I80 (8080 parallel)
    #  Use I80 if your 3.5" module has an 8080 FPC connector and
    #  SPI produces a white screen (IM pins may not be set for SPI).
    # ------------------------------------------------------------------

    choice IDMS_LCD_BUS
        prompt "LCD bus interface"
        default IDMS_LCD_BUS_SPI if IDF_TARGET_ESP32
        default IDMS_LCD_BUS_I80 if IDF_TARGET_ESP32S3

        config IDMS_LCD_BUS_SPI
            bool "SPI (4-wire serial)"
            help
                Use SPI with SCLK, MOSI, CS, DC pins. Requires IM[2:0]=111
                on the display module for 4-wire SPI mode.

        config IDMS_LCD_BUS_I80
            bool "I80 (8080 8-bit parallel)"
            help
                Use Intel 8080 8-bit parallel interface with D0-D7, WR, RD pins.
                Recommended for 3.5" TFT modules with 8080 FPC connector.
                Uses ESP32-S3 LCD_CAM peripheral for high-speed DMA transfers.
    endchoice

    # ------------------------------------------------------------------
    #  LCD SPI bus — dedicated to LCD only (not shared with anything).
    #  Uses SPI3_HOST. Only needed when LCD bus is SPI and not Topway.
    #  ESP32-S3 safe GPIOs: 1-18, 21-25, 33-42, 47-48
    #  ESP32-S3 avoid: 0/3/45/46 (strapping), 19/20 (USB), 26-32 (flash/PSRAM)
    # ------------------------------------------------------------------

    config IDMS_PIN_LCD_SCLK
        int "LCD SPI SCLK GPIO"
        range 0 48
        default 18 if IDF_TARGET_ESP32
        default 5 if IDF_TARGET_ESP32S3
        default 18
        depends on IDMS_LCD_BUS_SPI && !IDMS_DISPLAY_TOPWAY

    config IDMS_PIN_LCD_MOSI
        int "LCD SPI MOSI GPIO"
        range 0 48
        default 23 if IDF_TARGET_ESP32
        default 17 if IDF_TARGET_ESP32S3
        default 23
        depends on IDMS_LCD_BUS_SPI && !IDMS_DISPLAY_TOPWAY

    config IDMS_PIN_LCD_MISO
        int "LCD SPI MISO GPIO (-1 if unused)"
        range -1 48
        default -1
        depends on IDMS_LCD_BUS_SPI && !IDMS_DISPLAY_TOPWAY

    # ------------------------------------------------------------------
    #  I80 LCD pins (only when IDMS_LCD_BUS_I80)
    #  ESP32-S3: avoid GPIO 19/20 (USB D+/D-), 26-32 (flash/PSRAM),
    #  0/3/45/46 (strapping). Safe range: 1-18, 21-25, 33-42, 47-48.
    # ------------------------------------------------------------------

    config IDMS_PIN_LCD_I80_D0
        int "LCD I80 D0 GPIO"
        range 0 48
        default 33
        depends on IDMS_LCD_BUS_I80

    config IDMS_PIN_LCD_I80_D1
        int "LCD I80 D1 GPIO"
        range 0 48
        default 34
        depends on IDMS_LCD_BUS_I80

    config IDMS_PIN_LCD_I80_D2
        int "LCD I80 D2 GPIO"
        range 0 48
        default 35
        depends on IDMS_LCD_BUS_I80

    config IDMS_PIN_LCD_I80_D3
        int "LCD I80 D3 GPIO"
        range 0 48
        default 36
        depends on IDMS_LCD_BUS_I80

    config IDMS_PIN_LCD_I80_D4
        int "LCD I80 D4 GPIO"
        range 0 48
        default 37
        depends on IDMS_LCD_BUS_I80

    config IDMS_PIN_LCD_I80_D5
        int "LCD I80 D5 GPIO"
        range 0 48
        default 39
        depends on IDMS_LCD_BUS_I80

    config IDMS_PIN_LCD_I80_D6
        int "LCD I80 D6 GPIO"
        range 0 48
        default 40
        depends on IDMS_LCD_BUS_I80

    config IDMS_PIN_LCD_I80_D7
        int "LCD I80 D7 GPIO"
        range 0 48
        default 41
        depends on IDMS_LCD_BUS_I80

    config IDMS_PIN_LCD_I80_WR
        int "LCD I80 WR (write strobe) GPIO"
        range 0 48
        default 5
        depends on IDMS_LCD_BUS_I80

    config IDMS_PIN_LCD_I80_RD
        int "LCD I80 RD (read strobe) GPIO (-1 if tied to VCC)"
        range -1 48
        default 21
        depends on IDMS_LCD_BUS_I80

    config IDMS_PIN_LCD_I80_PCLK_HZ
        int "LCD I80 pixel clock speed (Hz)"
        default 10000000
        depends on IDMS_LCD_BUS_I80
        help
            I80 bus clock in Hz. 10 MHz is safe; increase to 20 MHz for
            faster refresh if the display supports it.

    # ------------------------------------------------------------------
    #  Common LCD pins (shared by SPI and I80)
    # ------------------------------------------------------------------

    config IDMS_PIN_LCD_DC
        int "LCD D/C (SPI) or RS (I80) GPIO"
        range 0 48
        default 2 if IDF_TARGET_ESP32
        default 4 if IDF_TARGET_ESP32S3
        default 2

    config IDMS_PIN_LCD_CS
        int "LCD chip select GPIO"
        range 0 48
        default 15 if IDF_TARGET_ESP32
        default 10 if IDF_TARGET_ESP32S3
        default 15

    config IDMS_PIN_LCD_BL
        int "LCD backlight GPIO (-1 to skip)"
        range -1 48
        default 21 if IDF_TARGET_ESP32
        default 38 if IDF_TARGET_ESP32S3
        default 21

    config IDMS_PIN_LCD_RST
        int "LCD reset GPIO (-1 to tie to EN)"
        range -1 48
        default -1 if IDF_TARGET_ESP32
        default 12 if IDF_TARGET_ESP32S3
        default -1

    # ------------------------------------------------------------------
    #  MAX31865 SPI bus — dedicated to RTD temperature sensors only.
    #  Uses SPI2_HOST. Shares bus with XPT2046 touch if enabled.
    #  ESP32-S3 safe GPIOs: 1-18, 21-25, 33-42, 47-48
    # ------------------------------------------------------------------

    config IDMS_PIN_MAX31865_SCLK
        int "MAX31865 SPI SCLK GPIO"
        range 0 48
        default 18
        depends on IDMS_TEMP_SENSOR_MAX31865

    config IDMS_PIN_MAX31865_MOSI
        int "MAX31865 SPI MOSI GPIO"
        range 0 48
        default 9 if IDF_TARGET_ESP32S3
        default 23 if IDF_TARGET_ESP32
        default 9
        depends on IDMS_TEMP_SENSOR_MAX31865

    config IDMS_PIN_MAX31865_MISO
        int "MAX31865 SPI MISO GPIO"
        range 0 48
        default 8 if IDF_TARGET_ESP32S3
        default 19 if IDF_TARGET_ESP32
        default 8
        depends on IDMS_TEMP_SENSOR_MAX31865

    # ------------------------------------------------------------------
    #  XPT2046 touch controller — dedicated SPI bus (SPI3_HOST)
    #  Must use different SCLK/MOSI/MISO pins from MAX31865 (SPI2_HOST)
    #  ESP32-S3 safe GPIOs: 1-18, 21-25, 33-42, 47-48
    # ------------------------------------------------------------------

    config IDMS_PIN_TOUCH_CS
        int "XPT2046 chip select GPIO (-1 to disable touch)"
        range -1 48
        default 33 if IDF_TARGET_ESP32
        default 11 if IDF_TARGET_ESP32S3
        default 33

    config IDMS_PIN_TOUCH_IRQ
        int "XPT2046 IRQ GPIO (-1 if unused)"
        range -1 48
        default 36 if IDF_TARGET_ESP32
        default 14 if IDF_TARGET_ESP32S3
        default 36

    config IDMS_PIN_TOUCH_SCLK
        int "XPT2046 SPI SCLK GPIO"
        range 0 48
        default 12 if IDF_TARGET_ESP32S3
        default 15 if IDF_TARGET_ESP32
        default 12
        depends on IDMS_PIN_TOUCH_CS >= 0

    config IDMS_PIN_TOUCH_MOSI
        int "XPT2046 SPI MOSI GPIO"
        range 0 48
        default 13 if IDF_TARGET_ESP32S3
        default 2 if IDF_TARGET_ESP32
        default 13
        depends on IDMS_PIN_TOUCH_CS >= 0

    config IDMS_PIN_TOUCH_MISO
        int "XPT2046 SPI MISO GPIO"
        range 0 48
        default 16 if IDF_TARGET_ESP32S3
        default 4 if IDF_TARGET_ESP32
        default 16
        depends on IDMS_PIN_TOUCH_CS >= 0

    config IDMS_LCD_SWAP_XY
        bool "Swap X/Y for landscape orientation"
        default y

    config IDMS_LCD_MIRROR_X
        bool "Mirror X"
        default n

    config IDMS_LCD_MIRROR_Y
        bool "Mirror Y"
        default n

    # ------------------------------------------------------------------
    #  UART pins for Topway Smart LCD — dedicated, not shared with SPI
    #  ESP32-S3: GPIO 1 and 3 are safe and NOT used by any SPI bus
    # ------------------------------------------------------------------

    config IDMS_PIN_UART_TX
        int "UART TX GPIO for Topway Smart LCD"
        range 0 48
        default 1 if IDF_TARGET_ESP32S3
        default 1 if IDF_TARGET_ESP32
        default 1
        depends on IDMS_DISPLAY_TOPWAY
        help
            TX pin for UART communication with Topway Smart LCD.
            Must NOT overlap with any SPI pin.

    config IDMS_PIN_UART_RX
        int "UART RX GPIO for Topway Smart LCD"
        range 0 48
        default 3 if IDF_TARGET_ESP32S3
        default 3 if IDF_TARGET_ESP32
        default 3
        depends on IDMS_DISPLAY_TOPWAY
        help
            RX pin for UART communication with Topway Smart LCD.
            Must NOT overlap with any SPI pin.

    config IDMS_PIN_UART_RTS
        int "UART RTS/BUSY GPIO for Topway Smart LCD (-1 if unused)"
        range -1 48
        default -1
        depends on IDMS_DISPLAY_TOPWAY
        help
            RTS (BUSY) pin from Topway display for flow control.
            The display pulls this LOW when busy processing a command.
            Set to -1 to skip flow control (not recommended for fast updates).

    config IDMS_TOPWAY_BAUD
        int "Topway UART baud rate"
        range 1200 921600
        default 9600
        depends on IDMS_DISPLAY_TOPWAY
        help
            Baud rate for UART communication with Topway Smart LCD.
            Default 9600 (JP1,JP7 close; JP2,JP8 open). Use 115200 for
            factory default jumper settings (JP1,JP7 close; JP2,JP8 open).

    config IDMS_UI_ENABLE
        bool "Enable LVGL + display UI"
        default y
        help
            When disabled, the firmware runs without the display stack (monitoring + Telegram still active).
            Note: Topway displays use native UI (no LVGL).

    menu "OTA Firmware Update"

        config IDMS_OTA_ENABLE
            bool "Enable OTA firmware update"
            default y
            help
                Enables over-the-air firmware updates via HTTP server or Telegram command.
                Requires a partition table with ota_0 and ota_1 slots.

        config IDMS_OTA_HTTP_PORT
            int "OTA HTTP server port"
            range 1024 65535
            default 8080
            help
                Port for the built-in OTA HTTP server. Access via http://<device-ip>:<port>/

        config IDMS_OTA_HTTPS_ENABLE
            bool "Enable HTTPS for OTA server (self-signed certificate)"
            default n
            help
                When enabled, the OTA HTTP server uses TLS with an embedded self-signed
                certificate.

        config IDMS_OTA_HTTP_AUTH_USER
            string "OTA HTTP admin username"
            default ""
            help
                HTTP basic auth username for OTA upload endpoint.
                If empty, must be set via serial console before first OTA update:
                > set_ota_user <username>

        config IDMS_OTA_HTTP_AUTH_PASS
            string "OTA HTTP admin password"
            default ""
            help
                HTTP basic auth password for OTA upload endpoint.
                If empty, must be set via serial console before first OTA update:
                > set_ota_pass <password>

        config IDMS_OTA_TELEGRAM_COMMAND
            bool "Enable OTA trigger via Telegram command"
            default y
            help
                When enabled, sending /ota_update to the bot triggers an OTA check.
                The actual firmware upload still happens via HTTP POST.

    endmenu

endmenu