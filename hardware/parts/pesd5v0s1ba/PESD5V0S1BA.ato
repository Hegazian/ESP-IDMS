"""
Nexperia PESD5V0S1BA — 5 V ESD Protection Diode
  - Bidirectional (symmetric) TVS
  - Working voltage: 5 V
  - Clamping voltage: ~12 V @ 1 A (8/20 µs)
  - Ultra-low capacitance: < 1 pF
  - Package: SOD-323 (2-pin SMD)
  - Ideal for 1-Wire, UART, and ADC protection

Usage: Connect cathode to signal line, anode to GND.
"""

#pragma experiment("TRAITS")
import has_designator_prefix
import has_part_picked

component PESD5V0S1BA:
    trait has_designator_prefix<prefix="D">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C50418", manufacturer="Nexperia", partno="PESD5V0S1BA">

    signal CATHODE ~ pin 1   # Connect to protected signal line
    signal ANODE ~ pin 2     # Connect to GND
